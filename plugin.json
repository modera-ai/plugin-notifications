{
  "apiVersion": 1,
  "activationScope": "global",
  "extensions": [],
  "id": "modera.notifications",
  "name": "Notifications",
  "version": "0.1.0",
  "description": "Publish agent messages to the system notification center.",
  "author": "Modera",
  "category": "productivity",
  "icon": "bell",
  "main": "dist/index.cjs",
  "permissions": [
    "notifications.show"
  ],
  "provides": {
    "modera.notifications.delivery": {
      "contract": "modera.notification-delivery",
      "apiVersion": 1
    }
  },
  "tools": [
    {
      "id": "notifications_manage",
      "title": "Notifications",
      "description": "Publish a plain-text message to the system notification center. Use only for meaningful background results, not routine progress.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": ["title", "body"]
      },
      "requiredPermissions": [
        "notifications.show"
      ]
    }
  ],
  "locales": {
    "zh-CN": {
      "name": "通知",
      "description": "向系统消息中心发布重要任务结果。"
    }
  }
}
