{
  "apiVersion": 1,
  "id": "modera.notifications",
  "name": "Notifications",
  "version": "0.1.0",
  "description": "Desktop notifications and a persistent inbox for completed tasks.",
  "author": "Modera",
  "category": "productivity",
  "icon": "bell",
  "main": "dist/index.cjs",
  "permissions": [
    "notifications.show",
    "runs.observe",
    "storage.read",
    "storage.write"
  ],
  "provides": {
    "modera.notifications.delivery": {
      "contract": "modera.notification-delivery",
      "apiVersion": 1
    }
  },
  "config": {
    "onCompletion": {
      "type": "boolean",
      "default": true,
      "title": "Notify when a run completes"
    }
  },
  "tools": [
    {
      "id": "notifications_manage",
      "title": "Notifications",
      "description": "Show a notification, list the inbox or mark an item read. Notification text is plain text.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "show",
              "list",
              "read"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "maxLength": 4000
          },
          "id": {
            "type": "string",
            "maxLength": 100
          }
        },
        "required": [
          "action"
        ]
      },
      "requiredPermissions": [
        "notifications.show",
        "storage.read",
        "storage.write"
      ]
    }
  ],
  "locales": {
    "zh-CN": {
      "name": "通知",
      "description": "任务完成通知和持久化通知收件箱。"
    }
  }
}
